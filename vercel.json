{
  "functions": {
    "api/evolve.js": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    },
    "api/state.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}